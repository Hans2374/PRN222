@page
@model SU25Lion.Pages.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="text-center mt-5">
    <h1 class="display-4">Access Denied</h1>
    <p class="lead text-danger">You have no permission to access this function!</p>
    <a asp-page="/Login" class="btn btn-primary">Return to Login</a>
    <a asp-page="/LionProfile/Index" class="btn btn-secondary">Go to Home</a>
</div>