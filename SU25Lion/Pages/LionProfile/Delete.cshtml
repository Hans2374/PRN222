@page
@model SU25Lion.Pages.LionProfile.IndexModel
@{
    ViewData["Title"] = "Lion Profiles";
}

<h2>Lion Profiles</h2>

@if (Model.CanCreate)
{
    <p>
        <a asp-page="Create" class="btn btn-primary">Create New</a>
    </p>
}

@if (Model.CanSearch)
{
    <div class="card mb-3">
        <div class="card-body">
            <form method="get">
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="SearchWeight" class="control-label">Weight</label>
                            <input asp-for="SearchWeight" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="SearchTypeName" class="control-label">Lion Type Name</label>
                            <input asp-for="SearchTypeName" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>&nbsp;</label>
                            <div>
                                <button type="submit" name="action" value="search" class="btn btn-info">Search</button>
                                <a asp-page="Index" class="btn btn-secondary">Clear</a>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.LionProfiles[0].LionName)</th>
            <th>@Html.DisplayNameFor(model => model.LionProfiles[0].Weight)</th>
            <th>Lion Type</th>
            <th>@Html.DisplayNameFor(model => model.LionProfiles[0].ModifiedDate)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.LionProfiles)
        {
            <tr id="row-@item.LionProfileId">
                <td>@item.LionName</td>
                <td>@item.Weight</td>
                <td>@item.LionType?.LionTypeName</td>
                <td>@item.ModifiedDate.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    @if (Model.CanView)
                    {
                        <a asp-page="./Detail" asp-route-id="@item.LionProfileId" class="btn btn-sm btn-info">Details</a>
                    }
                    @if (Model.CanUpdate)
                    {
                        <a asp-page="./Update" asp-route-id="@item.LionProfileId" class="btn btn-sm btn-warning">Edit</a>
                    }
                    @if (Model.CanDelete)
                    {
                        <a asp-page="./Delete" asp-route-id="@item.LionProfileId" class="btn btn-sm btn-danger">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.IsSearching)
{
    <nav>
        <ul class="pagination">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="Index" asp-route-pageNumber="@(Model.CurrentPage - 1)">Previous</a>
                </li>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-page="Index" asp-route-pageNumber="@i">@i</a>
                </li>
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="Index" asp-route-pageNumber="@(Model.CurrentPage + 1)">Next</a>
                </li>
            }
        </ul>
    </nav>
}

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/lionHub")
            .build();

        connection.on("ProfileDeleted", function (profileId) {
            const row = document.getElementById("row-" + profileId);
            if (row) {
                row.style.backgroundColor = "#ffcccc";
                setTimeout(() => {
                    row.remove();
                }, 500);
            }
        });

        connection.start().catch(function (err) {
            return console.error(err.toString());
        });
    </script>
}