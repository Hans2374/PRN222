@page
@model GameStore.Web.Pages.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="text-center">
    <h1 class="text-danger">Access Denied</h1>
    <p class="text-danger">You are not authorized to view this page.</p>
    <div class="mt-3">
        <form method="post" class="d-inline">
            <button type="submit" name="action" value="login" class="btn btn-primary">Go to Login</button>
            <button type="submit" name="action" value="cancel" class="btn btn-secondary ml-2">Cancel</button>
        </form>
    </div>
</div>