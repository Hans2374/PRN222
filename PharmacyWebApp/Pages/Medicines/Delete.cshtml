@page "{id}"
@model PharmacyWebApp.Pages.Medicines.DeleteModel
@{
    ViewData["Title"] = "Delete Medicine";
}

<h2>Delete Medicine</h2>

<div class="alert alert-danger">
    <h3>Are you sure you want to delete this medicine?</h3>
    <p>This action cannot be undone.</p>
</div>

<div>
    <dl class="row">
        <dt class="col-sm-3">Medicine ID</dt>
        <dd class="col-sm-9">@Model.Medicine.MedicineId</dd>

        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Medicine.MedicineName</dd>

        <dt class="col-sm-3">Active Ingredients</dt>
        <dd class="col-sm-9">@Model.Medicine.ActiveIngredients</dd>

        <dt class="col-sm-3">Expiration Date</dt>
        <dd class="col-sm-9">@Model.Medicine.ExpirationDate</dd>

        <dt class="col-sm-3">Dosage Form</dt>
        <dd class="col-sm-9">@Model.Medicine.DosageForm</dd>

        <dt class="col-sm-3">Warnings and Precautions</dt>
        <dd class="col-sm-9">@Model.Medicine.WarningsAndPrecautions</dd>

        <dt class="col-sm-3">Manufacturer</dt>
        <dd class="col-sm-9">@Model.Medicine.Manufacturer?.ManufacturerName</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Medicine.MedicineId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>