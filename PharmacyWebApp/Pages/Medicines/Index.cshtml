@page
@model PharmacyWebApp.Pages.Medicines.IndexModel
@{
    ViewData["Title"] = "Medicines";
}
<h2>Medicine List</h2>

<p>
    <a asp-page="./Create" class="btn btn-success">
        + Add New Medicine
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Medicine ID</th>
            <th>Name</th>
            <th>Active Ingredients</th>
            <th>Expiration Date</th>
            <th>Dosage Form</th>
            <th>Warnings</th>
            <th>Manufacturer</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var medicine in Model.Medicines)
        {
            <tr>
                <td>@medicine.MedicineId</td>
                <td>@medicine.MedicineName</td>
                <td>@medicine.ActiveIngredients</td>
                <td>@medicine.ExpirationDate</td>
                <td>@medicine.DosageForm</td>
                <td>@medicine.WarningsAndPrecautions</td>
                <td>@medicine.Manufacturer?.ManufacturerName</td>
                <td>
                    <a asp-page="./Details"
                       asp-route-id="@medicine.MedicineId"
                       class="btn btn-info btn-sm">
                        Details
                    </a>

                    <a asp-page="./Edit"
                       asp-route-id="@medicine.MedicineId"
                       class="btn btn-primary btn-sm">
                        Edit
                    </a>

                    <a asp-page="./Delete"
                       asp-route-id="@medicine.MedicineId"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Are you sure you want to delete this medicine?');">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="./Index" asp-route-pageNumber="@(Model.CurrentPage - 1)">Previous</a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Previous</span>
                </li>
            }
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ?"active":"")">
                    <a class="page-link" asp-page="./Index" asp-route-pageNumber="@i">
                        @i
                    </a>
                </li>
            }
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="./Index" asp-route-pageNumber="@(Model.CurrentPage + 1)">
                        Next
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">
                        Next
                    </span>
                </li>
            }
        </ul>
    </nav>
}